{
  "name": "free-opencode-api",
  "version": "5.0.0",
  "description": "Free OpenCode API — an OpenAI-compatible API gateway for the OpenCode CLI that exposes the free models OpenCode serves (stable alias: opencode/big-pickle) to any standard OpenAI client.",
  "main": "index.js",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinhdev666/free-opencode-api.git"
  },
  "bugs": {
    "url": "https://github.com/dinhdev666/free-opencode-api/issues"
  },
  "homepage": "https://github.com/dinhdev666/free-opencode-api#readme",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "start": "node index.js",
    "check": "node test/check-syntax.mjs",
    "check:commits": "node test/check-commit-messages.mjs",
    "test": "node test/smoke.mjs"
  },
  "keywords": [
    "opencode",
    "openai",
    "openai-compatible",
    "api-gateway",
    "llm-gateway",
    "proxy",
    "rest-api",
    "free-llm",
    "llm-api",
    "free-models",
    "nodejs"
  ],
  "author": "Phạm Văn Định",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=12.0.0"
  },
  "dependencies": {
    "@opencode/client": "2.3.2",
    "fastify": "^5.12.8"
  }
}
