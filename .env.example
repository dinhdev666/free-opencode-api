# Proxy configuration reference.
# Copy to `.env` and adjust, or set the variables in your process manager.
# Existing environment variables always win over the values in `.env`.

# --- proxy ------------------------------------------------------------------

# Port the proxy listens on.
PORT=20128

# Interface the proxy binds to. 0.0.0.0 makes it reachable from outside the
# container/host.
HOST=0.0.0.0

# API key clients must present as `Authorization: Bearer <API_KEY>`.
API_KEY=sk-dummy

# --- opencode ---------------------------------------------------------------

# Spawn and supervise `opencode serve` from node_modules/.bin.
# Set to false if you already run an opencode server yourself.
SPAWN_OPENCODE=true

# Where the opencode server listens.
OPENCODE_HOST=127.0.0.1
OPENCODE_PORT=4096

# Seconds to wait for a freshly spawned opencode server to become healthy.
OPENCODE_STARTUP_TIMEOUT=30

# Basic auth for the opencode server (only needed if you protect it).
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# Absolute path to an opencode binary. Leave empty to use the project-local
# install in node_modules/.bin.
OPENCODE_BIN=

# Working directory used as the opencode project root.
OPENCODE_WORKDIR=

# --- model ------------------------------------------------------------------

# Model used when a client does not specify one. Accepts `provider/model`,
# a bare model id, or `provider/model#variant`.
# Leave empty to require the client to send a model.
DEFAULT_MODEL=
DEFAULT_PROVIDER=opencode

# The opencode agent used for proxied requests. The project ships a `proxy`
# agent in opencode.json that has no tools and a minimal system prompt.
DEFAULT_AGENT=proxy

# --- limits -----------------------------------------------------------------

# Seconds a single chat completion may take.
REQUEST_TIMEOUT=300

# How many provider retries opencode may make before the proxy reports the
# failure. opencode's own default is 5 retries with a 2s -> 30s backoff, which
# blocks a request for ~90 seconds. 1 = fail on the first retry.
MAX_RETRY_ATTEMPTS=1

# --- misc -------------------------------------------------------------------

# pino log level: fatal | error | warn | info | debug | trace | silent
# `silent` keeps stdout quiet and writes no log files.
LOG_LEVEL=silent

# Owner string reported by /v1/models.
MODEL_OWNER=opencode
