{
  "name": "free-opencode-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Free OpenCode API — an OpenAI-compatible REST API proxy that reuses the AI models authenticated in the opencode CLI",
  "keywords": [
    "openai",
    "openai-compatible",
    "opencode",
    "proxy",
    "fastify",
    "api"
  ],
  "author": "Phạm Văn Định",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 test/*.test.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "fastify": "^5.12.8",
    "opencode-ai": "1.19.5"
  }
}
